{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["node", "react", "react-dom"]
  },
  "include": ["server/src/**/*.ts", "ui/src/**/*.tsx", "ui/src/**/*.d.ts"]
}
